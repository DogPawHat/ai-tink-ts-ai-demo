# @defaultRequired=infer @defaultSensitive=false
# @generateTsTypes(path=env.d.ts)
# ---

# Model ID as OpenRouter names it. Claude Code runs this model.
# @optional @example="anthropic/claude-haiku-5.5"
AGENT_MODEL=anthropic/claude-haiku-5.5

# OpenRouter API key for Claude Code (server only). Required to run the agent.
# @optional @sensitive
OPENROUTER_API_KEY=

# Anthropic-compatible base URL. The default is OpenRouter's. Set this to a
# gateway URL to route the calls elsewhere; the key may then be a placeholder.
# @optional @example="https://openrouter.ai/api"
OPENROUTER_BASE_URL=
