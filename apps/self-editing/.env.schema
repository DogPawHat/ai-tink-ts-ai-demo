# OpenCode Zen model ID, as provider/model.
# @optional @example="opencode/deepseek-v4.1-flash"
OPENCODE_MODEL=opencode/deepseek-v4.1-flash

# OpenCode Zen key, used with opencode/* models. Leave unset when OpenCode
# is already authenticated inside Drop.
# @optional @sensitive
OPENCODE_API_KEY=
