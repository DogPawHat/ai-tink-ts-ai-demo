{
  "name": "self-editing-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:site": "node scripts/pack-site.mjs",
    "build:widget": "vp build --config vite.widget.config.ts",
    "build:server": "vp pack src/server/index.ts --out-dir dist --format esm",
    "build": "vp run build:server && vp run build:widget && vp run build:site",
    "start": "node dist/index.mjs"
  },
  "dependencies": {
    "@fly/sprites": "^0.2.3",
    "@tanstack/ai": "^0.68.0",
    "@tanstack/ai-claude-code": "^0.8.1",
    "@tanstack/ai-persistence": "^0.8.3",
    "@tanstack/ai-sandbox": "^0.5.22",
    "@tanstack/ai-sandbox-sprites": "^0.2.5"
  },
  "devDependencies": {
    "@tanstack/ai-react": "^0.30.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
