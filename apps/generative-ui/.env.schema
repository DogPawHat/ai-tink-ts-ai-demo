# @defaultRequired=infer @defaultSensitive=false
# ---

# Anthropic model ID for the agent.
# @optional @example="claude-haiku-5-5"
ANTHROPIC_MODEL=claude-haiku-5-5

# Anthropic API key for the agent (server only).
# @optional @sensitive
ANTHROPIC_API_KEY=

# Turns off CopilotKit's anonymous runtime telemetry.
COPILOTKIT_TELEMETRY_DISABLED=true
