# Optional: override the default GitHub repository when using a fork
# DEMO_REPOSITORY_URL=https://github.com/your-name/ai-tink-ts-ai-demo.git

# Use a provider/model ID supported by OpenCode
OPENCODE_MODEL=openai/YOUR_MODEL_ID

# Vercel Sandbox SDK scope and authentication
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_TOKEN=

# Supply the key corresponding to OPENCODE_MODEL
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENROUTER_API_KEY=
